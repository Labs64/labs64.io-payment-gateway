{
  "name": "Labs64.IO Payment Gateway",
  "dockerComposeFile": "compose.yml",
  "service": "devcontainer",
  "workspaceFolder": "/workspaces/labs64.io-payment-gateway",
  "shutdownAction": "stopCompose",
  "remoteUser": "l64user",
  "updateRemoteUserUID": false,
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vmware.vscode-boot-dev-pack",
        "redhat.vscode-yaml",
        "ms-azuretools.vscode-docker"
      ]
    }
  },
  "forwardPorts": [8080, 5005, 15672, 3592],
  "portsAttributes": {
    "8080": { "label": "Payment Gateway API" },
    "5005": { "label": "Java debugger" },
    "15672": { "label": "RabbitMQ management" },
    "3592": { "label": "Cerbos HTTP API" }
  },
  "postCreateCommand": "just doctor"
}
