<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.labs64</groupId>
        <artifactId>labs64io-parent</artifactId>
        <version>0.0.4</version>
        <relativePath />
    </parent>

    <groupId>io.labs64</groupId>
    <artifactId>payment-gateway-providers</artifactId>
    <!-- Set by the release tag (-Drevision=<tag>); the 0.0.0-SNAPSHOT default is inherited. -->
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>Labs64.IO :: Payment Gateway :: Providers</name>
    <description>Payment provider SPI and provider implementations for Labs64.IO Payment Gateway</description>

    <modules>
        <module>providers-spi</module>
        <module>noop</module>
        <module>paypal</module>
        <module>stripe</module>
    </modules>

    <!-- Needed here (not only in the parent): Maven must reach Labs64 Nexus to find
         io.labs64:labs64io-parent in the first place. -->
    <repositories>
        <repository>
            <id>labs64-nexus</id>
            <name>Labs64 Nexus Releases</name>
            <url>https://nexus.labs64.com/repository/labs64.io-releases/</url>
        </repository>
        <repository>
            <id>labs64-nexus-snapshots</id>
            <name>Labs64 Nexus Snapshots</name>
            <url>https://nexus.labs64.com/repository/labs64.io-snapshots/</url>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.labs64</groupId>
                <artifactId>payment-provider-spi</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.labs64</groupId>
                <artifactId>payment-gateway-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>${commons-lang3.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${java.version}</release>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
