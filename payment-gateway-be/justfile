APP_NAME := "payment-gateway"
REGISTRY  := env_var_or_default("REGISTRY", "localhost:5005")
TAG       := env_var_or_default("TAG", "latest")

COMPOSE      := "bash ./docker/compose.sh"
COMPOSE_BASE := "-f docker-compose.yml"
COMPOSE_APP  := "-f docker-compose.yml -f docker-compose.app.yml"
COMPOSE_DEV  := "-f docker-compose.yml -f docker-compose.dev.yml"

# show available recipes
default:
    @just --list

# ── Build ────────────────────────────────────────────────────────────

# compile and package (skip tests)
build:
    mvn -f ../pom.xml -pl payment-gateway-be -am clean package -DskipTests

# compile, run tests, and package
test:
    mvn -f ../pom.xml -pl payment-gateway-be -am clean verify

# run only unit tests (no integration tests)
unit-test:
    mvn -f ../pom.xml -pl payment-gateway-be -am test

# ── Docker ───────────────────────────────────────────────────────────

# build docker image
docker-build: build
    docker build -t {{APP_NAME}}:{{TAG}} .
    docker images | grep "{{APP_NAME}}"

# build and push docker image to registry
docker-push: docker-build
    docker tag {{APP_NAME}}:{{TAG}} {{REGISTRY}}/{{APP_NAME}}:{{TAG}}
    docker push {{REGISTRY}}/{{APP_NAME}}:{{TAG}}

# ── Docker Compose ───────────────────────────────────────────────────

# start shared local infrastructure only
infra-up:
    {{COMPOSE}} {{COMPOSE_BASE}} up -d
    {{COMPOSE}} {{COMPOSE_BASE}} ps

# stop local infrastructure (keeps volumes)
infra-down:
    {{COMPOSE}} {{COMPOSE_BASE}} down

# tail logs from local infrastructure
infra-logs:
    {{COMPOSE}} {{COMPOSE_BASE}} logs -f

# stop the Compose project and remove its volumes (destructive)
infra-reset:
    {{COMPOSE}} {{COMPOSE_BASE}} down -v --remove-orphans

# build and start the production-like application image with infrastructure
smoke-up: build
    {{COMPOSE}} {{COMPOSE_APP}} up -d --build --remove-orphans
    {{COMPOSE}} {{COMPOSE_APP}} ps

# stop the production-like application stack (keeps volumes)
smoke-down:
    {{COMPOSE}} {{COMPOSE_APP}} down --remove-orphans

# tail logs from the production-like application stack
smoke-logs:
    {{COMPOSE}} {{COMPOSE_APP}} logs -f

# start the debug application container with infrastructure
dev-up: build
    {{COMPOSE}} {{COMPOSE_DEV}} up -d --remove-orphans
    {{COMPOSE}} {{COMPOSE_DEV}} ps

# watch the packaged JAR and restart the debug application when it changes
dev-watch: build
    {{COMPOSE}} {{COMPOSE_DEV}} watch

# stop the debug application stack (keeps volumes)
dev-down:
    {{COMPOSE}} {{COMPOSE_DEV}} down --remove-orphans

# tail logs from the debug application stack
dev-logs:
    {{COMPOSE}} {{COMPOSE_DEV}} logs -f

# ── Run ──────────────────────────────────────────────────────────────

# build reactor artifacts and run application with local profile
run:
    mvn -f ../pom.xml -pl payment-gateway-be -am install -DskipTests
    mvn spring-boot:run -Dspring-boot.run.profiles=local -f pom.xml

# ── Dev Tools ────────────────────────────────────────────────────────

# open Swagger UI in browser
docu:
    open "http://localhost:8080/swagger-ui/index.html"

# open RabbitMQ management UI in browser
rabbitmq-ui:
    open "http://localhost:15672"

# clean build artifacts
clean:
    mvn -f ../pom.xml -pl payment-gateway-be -am clean

# check for dependency, plugin, and property version updates
check-updates:
    mvn versions:display-plugin-updates -Dmaven.version.ignore='(?i).*[.-]?(alpha|beta|RC|M)\d*' -f pom.xml
    mvn versions:display-property-updates -Dmaven.version.ignore='(?i).*[.-]?(alpha|beta|RC|M)\d*' -f pom.xml
    mvn versions:display-dependency-updates -DprocessDependencyManagement=false -Dmaven.version.ignore='(?i).*[.-]?(alpha|beta|RC|M)\d*' -f pom.xml

# scan docker image for CVEs (requires docker scout)
scan: docker-build
    docker scout cves {{APP_NAME}}:{{TAG}}
