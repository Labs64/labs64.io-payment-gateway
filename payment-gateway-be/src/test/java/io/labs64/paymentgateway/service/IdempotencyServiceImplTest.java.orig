package io.labs64.paymentgateway.service;

import java.util.Map;
import java.util.Optional;

import com.fasterxml.jackson.databind.ObjectMapper;
import io.labs64.paymentgateway.exception.ConflictException;
import io.labs64.paymentgateway.exception.IdempotencyConflictException;
import io.labs64.paymentgateway.idempotency.IdempotencyContext;
import io.labs64.paymentgateway.idempotency.IdempotencyOperation;
import io.labs64.paymentgateway.idempotency.IdempotencyResponse;
import io.labs64.paymentgateway.message.IdempotencyMessages;
import io.labs64.paymentgateway.repository.RedisIdempotencyRepository;
import io.labs64.paymentgateway.repository.RedisIdempotencyRepository.CompletionStatus;
import io.labs64.paymentgateway.repository.RedisIdempotencyRepository.StartResult;
import io.labs64.paymentgateway.repository.RedisIdempotencyRepository.StartStatus;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.ArgumentCaptor;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import org.springframework.http.HttpHeaders;

import static org.assertj.core.api.Assertions.assertThat;
import static org.assertj.core.api.Assertions.assertThatThrownBy;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.ArgumentMatchers.anyInt;
import static org.mockito.ArgumentMatchers.anyString;
import static org.mockito.ArgumentMatchers.eq;
import static org.mockito.Mockito.verify;
import static org.mockito.Mockito.when;

@ExtendWith(MockitoExtension.class)
class IdempotencyServiceImplTest {

    @Mock
    private RedisIdempotencyRepository repository;

    @Mock
    private IdempotencyMessages msg;

    private IdempotencyServiceImpl service;

    @BeforeEach
    void setUp() {
        service = new IdempotencyServiceImpl(repository, new ObjectMapper(), msg);
    }

    @Test
    void startOrReplayCreatesProcessingRecordWhenKeyDoesNotExist() {
        when(repository.startOrReplay(any())).thenReturn(result(StartStatus.STARTED));

        assertThat(service.startOrReplay(context())).isEmpty();
    }

    @Test
    void startOrReplayReturnsCompletedCachedResponse() {
        when(repository.startOrReplay(any())).thenReturn(new StartResult(
                StartStatus.COMPLETED,
                "201",
                "{\"Location\":[\"/payments/123\"]}",
                "{\"id\":\"payment-1\"}"));

        final Optional<IdempotencyResponse> response = service.startOrReplay(context());

        assertThat(response).isPresent();
        assertThat(response.get().status()).isEqualTo(201);
        assertThat(response.get().headers().getFirst("Location")).isEqualTo("/payments/123");
        assertThat(response.get().body()).isEqualTo(Map.of("id", "payment-1"));
    }

    @Test
    void startOrReplayThrowsWhenRequestHashDiffers() {
        when(repository.startOrReplay(any())).thenReturn(result(StartStatus.CONFLICT));
        when(msg.requestHashConflict()).thenReturn("hash conflict");

        assertThatThrownBy(() -> service.startOrReplay(context()))
                .isInstanceOf(IdempotencyConflictException.class);
    }

    @Test
    void startOrReplayThrowsWhenSameRequestIsStillProcessing() {
        when(repository.startOrReplay(any())).thenReturn(result(StartStatus.PROCESSING));
        when(msg.stillProcessing()).thenReturn("still processing");

        assertThatThrownBy(() -> service.startOrReplay(context()))
                .isInstanceOf(ConflictException.class);
    }

    @Test
    void completeStoresResponse() {
        when(repository.complete(any(), anyInt(), anyString(), anyString()))
                .thenReturn(CompletionStatus.COMPLETED);

        service.complete(context(), new IdempotencyResponse(
                201, new HttpHeaders(), Map.of("id", "payment-1")));
    }

    @Test
    void completeThrowsWhenRecordWasNotInitialized() {
        when(repository.complete(any(), anyInt(), anyString(), anyString()))
                .thenReturn(CompletionStatus.MISSING);
        when(msg.recordNotInitialized()).thenReturn("not initialized");

        assertThatThrownBy(() -> service.complete(context(), response()))
                .isInstanceOf(ConflictException.class);
    }

    @Test
    void completeThrowsWhenRequestHashDiffers() {
        when(repository.complete(any(), anyInt(), anyString(), anyString()))
                .thenReturn(CompletionStatus.CONFLICT);
        when(msg.requestHashConflict()).thenReturn("hash conflict");

        assertThatThrownBy(() -> service.complete(context(), response()))
                .isInstanceOf(IdempotencyConflictException.class);
    }

    @Test
    void completeRejectsStaleExecutionOwner() {
        when(repository.complete(any(), anyInt(), anyString(), anyString()))
                .thenReturn(CompletionStatus.STALE_OWNER);
        when(msg.stillProcessing()).thenReturn("stale owner");

        assertThatThrownBy(() -> service.complete(context(), response()))
                .isInstanceOf(ConflictException.class);
    }

    private static StartResult result(final StartStatus status) {
        return new StartResult(status, null, null, null);
    }

    private static IdempotencyResponse response() {
        return new IdempotencyResponse(200, new HttpHeaders(), null);
    }

    private static IdempotencyContext context() {
        return new IdempotencyContext(
                "tenant-a",
                "idk-1",
                "hash-1",
                "execution-1",
                new IdempotencyOperation("POST", "/api/v1/payments/{paymentId}/pay"));
    }
}
