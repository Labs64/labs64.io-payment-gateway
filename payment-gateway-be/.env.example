# ── PostgreSQL ───────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=paymentgateway
DB_USERNAME=paymentgateway
DB_PASSWORD=paymentgateway

# ── Redis ────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── AuditFlow service-to-service publishing ─────────────────────────
AUDITFLOW_URL=http://gateway.localhost/auditflow
AUDITFLOW_OAUTH_TOKEN_URI=http://keycloak.localhost/realms/labs64io/protocol/openid-connect/token
AUDITFLOW_OAUTH_CLIENT_ID=payment-gateway
AUDITFLOW_OAUTH_CLIENT_SECRET=
AUDITFLOW_OAUTH_SCOPES=audit-event:write
