<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.labs64</groupId>
    <artifactId>payment-gateway</artifactId>
    <!-- Set by the release tag (-Drevision=<tag>); the 0.0.0-SNAPSHOT default is inherited. -->
    <version>${revision}</version>
    <packaging>jar</packaging>

    <name>Labs64.IO :: Payment Gateway :: Backend</name>
    <description>Labs64.IO - Payment Gateway</description>

    <parent>
        <groupId>io.labs64</groupId>
        <artifactId>labs64io-parent</artifactId>
        <version>0.0.4</version>
        <relativePath />
    </parent>

    <properties>
        <!-- API VERSIONS -->
        <payment-gateway.version>v1</payment-gateway.version>
        <!-- Same repository, same release: the contract and the providers carry this module's version. -->
        <payment-gateway-api.version>${project.version}</payment-gateway-api.version>
        <!-- The one cross-module pin. Point it at a released AuditFlow version before
             releasing: a release build refuses -SNAPSHOT inputs. -->
        <auditflow-api.version>0.0.19</auditflow-api.version>
        <!-- Shared dependency/plugin versions and Spring Boot BOM overrides come from labs64io-parent -->
        <payment-provider.version>${project.version}</payment-provider.version>
        <openapi.contract.directory>${project.build.directory}/payment-gateway-api</openapi.contract.directory>
        <openapi.source>${openapi.contract.directory}/openapi/openapi-payment-gateway-${payment-gateway.version}.yaml</openapi.source>
        <openapi.generated>${project.build.directory}/generated-openapi/openapi-payment-gateway-v1.yaml</openapi.generated>
        <!-- Cerbos policies + routes manifest generated from x-labs64.auth.
             auth-policy.module must equal the module's gateway prefix
             (= policy-sources.yaml name); it is baked into the Cerbos resource
             kind (payment-gateway -> payment_gateway_api). Generated output is a
             build artifact only — the central Cerbos PDP owns the live set. -->
        <auth-policy-cerbos.output>${project.build.directory}/cerbos</auth-policy-cerbos.output>
        <!-- Public OpenAPI operations inferred from x-labs64.auth, consumed by
             the backend AuthContextFilter so public
             paths are never hand-maintained. -->
        <auth-public-paths.generated>${project.build.directory}/generated-resources/auth-public-paths</auth-public-paths.generated>
        <auth-policy.module>payment-gateway</auth-policy.module>
    </properties>

    <dependencies>
        <!-- Canonical Payment Gateway API contract models. The backend generates
             only Spring server interfaces and implements them against these
             shared, consumer-facing DTOs. -->
        <dependency>
            <groupId>io.labs64</groupId>
            <artifactId>payment-gateway-api</artifactId>
            <version>${payment-gateway-api.version}</version>
        </dependency>

        <!-- No in-app OpenTelemetry SDK on the classpath (guardrail #4). Tracing and
             log-trace correlation are infrastructure-owned: the bundled OTel Java Agent
             (activated via JAVA_TOOL_OPTIONS when observability.enabled) auto-instruments
             HTTP/JDBC/Redis and injects trace_id/span_id into the logback MDC. Metrics stay
             on Micrometer + /actuator/prometheus (see micrometer-registry-prometheus below).
             Matches the auditflow reference — see OBSERVABILITY.md / RFC 03. -->
        <!-- Spring Boot Starter -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-json</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Framework-independent auth-context model and internal header encoding. -->
        <dependency>
            <groupId>io.labs64</groupId>
            <artifactId>auth-context-core</artifactId>
        </dependency>
        <!-- Trusted gateway auth-context: X-Auth-* parsing, fail-closed
             enforcement and propagation. Replaces the former in-app Spring Security
             stack (SecurityConfig/DevAuthFilter). Served by Labs64 Nexus. -->
        <dependency>
            <groupId>io.labs64</groupId>
            <artifactId>auth-context-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>io.projectreactor.netty</groupId>
            <artifactId>reactor-netty-http</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-handler</artifactId>
            <version>${netty.version}</version>
        </dependency>
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>${logstash.version}</version>
        </dependency>

        <!-- OpenAPI -->
        <dependency>
            <groupId>io.labs64</groupId>
            <artifactId>openapi-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openapitools</groupId>
            <artifactId>jackson-databind-nullable</artifactId>
            <version>${openapitools.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>${jackson-datatype.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>${commons-lang3.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Spring Data JPA -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- PostgreSQL -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Redis -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- MapStruct -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>

        <!-- AuditFlow HTTP client; internal auth headers come from auth-context-core. -->
        <dependency>
            <groupId>io.labs64</groupId>
            <artifactId>auditflow-api</artifactId>
            <version>${auditflow-api.version}</version>
        </dependency>

        <!-- Payment provider SPI and runtime implementations -->
        <dependency>
            <groupId>io.labs64</groupId>
            <artifactId>payment-provider-spi</artifactId>
            <version>${payment-provider.version}</version>
        </dependency>
        <dependency>
            <groupId>io.labs64</groupId>
            <artifactId>payment-provider-noop</artifactId>
            <version>${payment-provider.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.labs64</groupId>
            <artifactId>payment-provider-paypal</artifactId>
            <version>${payment-provider.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.labs64</groupId>
            <artifactId>payment-provider-stripe</artifactId>
            <version>${payment-provider.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Micrometer Prometheus registry: serves /actuator/prometheus for the
             infrastructure-owned metrics scrape (matches auditflow/checkout). Java metrics
             stay on Micrometer/Prometheus, never app-side OTLP — see OBSERVABILITY.md / RFC 03. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Lombok (optional, for reducing boilerplate code) -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- Needed here (not only in the parent): Maven must reach Labs64 Nexus to find
         io.labs64:labs64io-parent in the first place. -->
    <repositories>
        <repository>
            <id>labs64-nexus</id>
            <name>Labs64 Nexus Releases</name>
            <url>https://nexus.labs64.com/repository/labs64.io-releases/</url>
        </repository>
        <repository>
            <id>labs64-nexus-snapshots</id>
            <name>Labs64 Nexus Snapshots</name>
            <url>https://nexus.labs64.com/repository/labs64.io-snapshots/</url>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <release>${java.version}</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>${lombok-mapstruct-binding.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <arg>-Amapstruct.defaultComponentModel=spring</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Resolve the canonical spec from the same Maven artifact that
                 supplies the shared models; no sibling checkout is required. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>${maven-dependency-plugin.version}</version>
                <executions>
                    <execution>
                        <id>extract-payment-gateway-openapi</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>io.labs64</groupId>
                                    <artifactId>payment-gateway-api</artifactId>
                                    <version>${payment-gateway-api.version}</version>
                                    <type>jar</type>
                                    <includes>openapi/openapi-payment-gateway-${payment-gateway.version}.yaml</includes>
                                    <outputDirectory>${openapi.contract.directory}</outputDirectory>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>generate-auth-openapi-policy</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>io.labs64.authcontext.openapi.OpenApiAuthPreprocessorCli</mainClass>
                            <classpathScope>compile</classpathScope>
                            <arguments>
                                <argument>--input</argument>
                                <argument>${openapi.source}</argument>
                                <argument>--openapi-output</argument>
                                <argument>${openapi.generated}</argument>
                                <argument>--cerbos-output</argument>
                                <argument>${auth-policy-cerbos.output}</argument>
                                <argument>--public-paths-output</argument>
                                <argument>${auth-public-paths.generated}</argument>
                                <argument>--module</argument>
                                <argument>${auth-policy.module}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <version>${openapi-generator-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>labs64.io-payment-gateway</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <phase>generate-sources</phase>
                        <configuration>
                            <inputSpec>${openapi.generated}</inputSpec>
                            <generatorName>spring</generatorName>
                            <output>${project.build.directory}/generated-sources</output>
                            <apiPackage>io.labs64.paymentgateway.api</apiPackage>
                            <modelPackage>io.labs64.paymentgateway.model</modelPackage>
                            <generateModels>false</generateModels>
                            <generateSupportingFiles>true</generateSupportingFiles>
                            <configOptions>
                                <useTags>true</useTags>
                                <interfaceOnly>true</interfaceOnly>
                                <useSpringBoot3>true</useSpringBoot3>
                                <openApiNullable>false</openApiNullable>
                                <unhandledException>false</unhandledException>
                                <containerDefaultToNull>true</containerDefaultToNull>
                            </configOptions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>${build-helper-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>add-source</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.build.directory}/generated-sources/src/main/java</source>
                            </sources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>add-generated-resources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-resource</goal>
                        </goals>
                        <configuration>
                            <resources>
                                <resource>
                                    <directory>${project.build.directory}/generated-resources</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
