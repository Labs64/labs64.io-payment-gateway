{
  "name": "PayPal - capture order",
  "request": {
    "method": "POST",
    "urlPath": "/v2/checkout/orders/PAYPAL-ORDER-PSP-STUB/capture",
    "headers": {
      "Authorization": {
        "equalTo": "Bearer paypal-access-token"
      }
    }
  },
  "response": {
    "status": 201,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "id": "PAYPAL-ORDER-PSP-STUB",
      "status": "COMPLETED",
      "purchase_units": [
        {
          "payments": {
            "captures": [
              {
                "id": "PAYPAL-CAPTURE-PSP-STUB",
                "status": "COMPLETED",
                "amount": {
                  "currency_code": "USD",
                  "value": "30.00"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
