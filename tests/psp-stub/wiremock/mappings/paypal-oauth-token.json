{
  "name": "PayPal - issue normal OAuth token",
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/v1/oauth2/token",
    "headers": {
      "Authorization": {
        "equalTo": "Basic cGF5cGFsLWNsaWVudC1pZDpwYXlwYWwtY2xpZW50LXNlY3JldA=="
      }
    },
    "bodyPatterns": [
      {
        "contains": "grant_type=client_credentials"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "scope": "https://uri.paypal.com/services/payments/payment",
      "access_token": "paypal-access-token",
      "token_type": "Bearer",
      "app_id": "APP-PSP-STUB",
      "expires_in": 32400,
      "nonce": "paypal-psp-stub-nonce"
    }
  }
}
